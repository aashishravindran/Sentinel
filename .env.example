# =============================================================================
# .env — credentials for scripts/setup_aws.py (infrastructure provisioning).
#
# This file is for the SETUP SCRIPT ONLY.
# It requires admin-level permissions to create DynamoDB tables, S3 buckets,
# IAM roles, OpenSearch Serverless collections, and Bedrock Knowledge Bases.
#
# Runtime credentials for the MCP server go in .mcp.json, not here.
# .env is gitignored and never committed.
# =============================================================================

# AWS region to provision resources in.
AWS_REGION=us-east-1

# --- Auth: pick one option ---

# Option A: Named profile (recommended — no keys stored in this file).
# The profile must exist in ~/.aws/credentials or ~/.aws/config.
AWS_PROFILE=default

# Option B: Static access keys (CI, Docker, or environments without ~/.aws).
# Comment out AWS_PROFILE above and uncomment these.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...    # only for temporary / SSO credentials
